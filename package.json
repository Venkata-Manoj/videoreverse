{
  "name": "vidrev",
  "version": "1.1.0",
  "description": "Universal Video-to-Prompt Pipeline — deconstruct any video into production-ready prompts for 8+ AI video models",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "vidrev": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "pipeline": "node src/pipeline.js",
    "ingest": "node src/ingest.js",
    "test": "node src/run_tests.js",
    "lint": "node scripts/lint.js",
    "validate": "node scripts/validate.js",
    "compare": "node utils/compare.js",
    "stats": "node -e \"import { getCacheStats } from './utils/cache.js'; console.log(JSON.stringify(getCacheStats(), null, 2))\"",
    "benchmark": "node scripts/validate.js --benchmark",
    "cache:clear": "node -e \"import { clearCache } from './utils/cache.js'; clearCache(); console.log('Cache cleared')\"",
    "cache:stats": "node -e \"import { getCacheStats } from './utils/cache.js'; const s = getCacheStats(); console.log('Entries:', s.total, '| Size:', (s.total_size_bytes/1024).toFixed(1), 'KB')\""
  },
  "keywords": [
    "video",
    "prompt",
    "ai",
    "video-generation",
    "runway",
    "sora",
    "kling",
    "gemini",
    "veo",
    "luma",
    "pika",
    "haiper",
    "stable-video-diffusion"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Venkata-Manoj/videoreverse.git"
  },
  "bugs": {
    "url": "https://github.com/Venkata-Manoj/videoreverse/issues"
  },
  "homepage": "https://github.com/Venkata-Manoj/videoreverse#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0"
  },
  "devDependencies": {}
}
