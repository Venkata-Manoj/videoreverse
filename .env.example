# Environment Variables Template
# Copy this file to .env and fill in your values

# Gemini API Key (required for primary synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, used as fallback when Gemini is unavailable)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom output directory
# VIDEO_REV_OUTPUT_DIR=./output_blueprints

# Optional: Custom config directory
# VIDEO_REV_CONFIG_DIR=./config

# Groq API Key (optional, used as primary Whisper transcription backend)
# Get one at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (optional, free fallback via Kimi K2.6)
# Get one at https://openrouter.ai/keys (no credit card needed)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM API Key (optional, free fallback via Gemma 4 31B)
# Get one at https://build.nvidia.com (no credit card needed)
# NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Optional: Enable debug logging
# VIDEO_REV_LOG_LEVEL=debug