    "enhancement_rules": {
      "preferred_order": ["style", "duration", "action", "environment", "camera", "framing", "lighting", "color_grading"],
      "keyword_injection": {
        "realism_keywords": ["photorealistic", "hyper-detailed", "true-to-life", "natural textures"],
        "quality_keywords": ["high fidelity", "sharp focus", "clean composition", "professional grade"]
