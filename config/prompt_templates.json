    "aspect_ratio_support": ["16:9", "9:16", "1:1", "4:3"],
    "negative_placeholder": "--no {negative}",
    "notes": "Uses --no flag for negatives. Short duration. Good for stylized and animated content.",
    "enhancement_rules": {
      "preferred_order": ["style", "action", "environment", "camera", "framing", "lighting"],
      "keyword_injection": {
        "style_keywords": ["animated", "stylized", "illustrated", "cartoon", "anime-inspired", "motion graphics"],
        "animation_keywords": ["smooth animation", "frame-by-frame", "cel-shaded", "vector art"],
        "vibe_keywords": ["playful", "whimsical", "dreamy", "ethereal"]
