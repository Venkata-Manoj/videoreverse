        "sentence_style": "action-first",
        "emphasize_motion": true,
        "emphasize_atmosphere": true,
        "emphasize_human_motion": true,
        "avoid_adjectives": ["stunning", "breathtaking", "amazing"],
        "prefer_specifics": ["smooth gimbal tracking", "slow-motion capture", "dramatic backlighting", "moody atmosphere", "natural human movement"],
        "composition_tips": "Kling excels at human subjects. Describe body language, facial expressions, and weight distribution. Action should lead the prompt."
      }
    }
