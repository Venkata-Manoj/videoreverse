{
  "runway_gen4_5": {
    "label": "Runway Gen-4.5",
    "template": "[Camera: {camera} | Framing: {framing}] {style} style video showing {action}. Set in {environment}. {lighting} Duration: {duration}s. {negative}",
    "supports_negative": false,
    "max_duration": 16,
    "aspect_ratio_support": ["16:9", "9:16", "1:1", "4:3", "3:4"],
    "negative_placeholder": "",
    "notes": "Camera direction must come first. Keep prompts concise. No negative prompt support. Excels at cinematic realism and precise camera control.",
    "enhancement_rules": {
      "preferred_order": ["camera", "framing", "style", "action", "environment", "lighting", "duration"],
      "keyword_injection": {
        "camera_keywords": ["35mm lens", "50mm lens", "85mm lens", "f/2.8", "f/4", "shallow depth of field", "rack focus", "tilt-shift", "anamorphic lens", "prime lens"],
        "framing_keywords": ["extreme wide establishing", "wide shot", "medium wide", "medium shot", "medium close-up", "close-up", "extreme close-up", "over-the-shoulder", "point-of-view", "low-angle", "high-angle", "dutch angle", "top-down"],
        "style_keywords": ["cinematic", "photorealistic", "film grain", "color graded", "anamorphic bokeh", "HDR", "film stock emulation"],
        "action_keywords": ["smooth motion", "continuous movement", "natural physics", "subtle micro-movements", "organic motion"],
        "lighting_keywords": ["golden hour", "blue hour", "studio lighting", "natural window light", "volumetric rays", "rim lighting", "soft diffused", "hard directional"]
      },
      "prompt_guidelines": {
        "max_length": 300,
        "sentence_style": "concise",
        "camera_first": true,
        "avoid_adjectives": ["stunning", "breathtaking", "amazing", "beautiful", "gorgeous"],
        "avoid_phrases": ["we see", "the viewer notices"],
        "prefer_specifics": ["35mm lens", "f/2.8", "shallow depth of field", "medium close-up", "slow push-in", "golden hour backlight"],
        "temporal_keywords": ["slowly", "gradually", "steadily"],
        "composition_tips": "Runway responds well to specific lens/focal length mentions. Always lead with camera movement."
      }
    }
  },
  "google_veo3_1": {
    "label": "Google Veo 3.1",
    "template": "{style}. {lighting}. A {duration}-second clip showing {action} in {environment}. Camera: {camera}, framed as {framing}. {color_grading}. {negative}",
    "supports_negative": true,
    "max_duration": 60,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "Avoid: {negative}",
    "notes": "Thrives on environment physics, color grading, and realistic scene details. Excels at complex scene understanding and temporal coherence. Supports negative prompts.",
    "enhancement_rules": {
      "preferred_order": ["style", "lighting", "action", "environment", "camera", "framing", "color_grading"],
      "keyword_injection": {
        "environment_keywords": ["realistic physics", "natural lighting interaction", "spatial depth", "atmospheric perspective", "environmental storytelling", "background activity"],
        "color_keywords": ["color palette", "tonal range", "color temperature", "saturation level", "complementary colors", "color harmony"],
        "physics_keywords": ["gravity", "momentum", "fluid dynamics", "light reflection", "shadow casting", "particle interaction", "surface tension"],
        "lighting_keywords": ["volumetric fog", "god rays", "subsurface scattering", "specular highlights", "ambient occlusion", "bounce light"],
        "temporal_keywords": ["as the scene progresses", "over time", "gradually shifting", "evolving naturally"]
      },
      "prompt_guidelines": {
        "max_length": 500,
        "sentence_style": "descriptive",
        "emphasize_physics": true,
        "emphasize_environment": true,
        "emphasize_temporal_coherence": true,
        "avoid_adjectives": ["stunning", "breathtaking", "amazing"],
        "prefer_specifics": ["warm golden hour light", "cool blue shadows", "volumetric fog", "natural color grading", "realistic water reflections", "accurate shadow behavior"],
        "composition_tips": "Veo excels at physics simulation. Describe how light interacts with surfaces, how objects move with weight, and how the environment changes over time."
      }
    }
  },
  "kling_3_0": {
    "label": "Kling 3.0",
    "template": "{action}, captured via {camera} in {framing}. Location: {environment}. Style: {style}. Atmosphere: {lighting}. Duration: {duration}s. Color: {color_grading}. {negative}",
    "supports_negative": true,
    "max_duration": 30,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "Negative prompt: {negative}",
    "notes": "Responds well to fluid action sequences, motion pacing terms, and atmospheric composition. Strong at human motion and facial expressions.",
    "enhancement_rules": {
      "preferred_order": ["action", "camera", "framing", "environment", "style", "lighting", "duration", "color_grading"],
      "keyword_injection": {
        "motion_keywords": ["fluid motion", "smooth tracking", "dynamic movement", "continuous flow", "natural pacing", "weighty movement", "organic motion"],
        "atmosphere_keywords": ["moody atmosphere", "ambient lighting", "cinematic mood", "dramatic tension", "immersive environment"],
        "pacing_keywords": ["slow motion", "real-time", "accelerated", "rhythmic movement", "deliberate pace", "energetic"],
        "human_keywords": ["natural facial expressions", "subtle body language", "realistic weight shift", "authentic movement"],
        "camera_keywords": ["gimbal tracking", "steadicam", "handheld", "crane shot", "dolly zoom", "orbit"]
      },
      "prompt_guidelines": {
