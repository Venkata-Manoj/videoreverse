  },
  "haiper_2": {
    "label": "Haiper 2.0",
    "template": "{style} footage lasting {duration}s. {action} within {environment}. Camera uses {camera} with {framing}. {lighting}. {color_grading}. {negative}",
    "supports_negative": false,
    "max_duration": 8,
