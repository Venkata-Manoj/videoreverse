{
  "runway_gen4_5": {
    "label": "Runway Gen-4.5",
    "template": "[Camera: {camera} | Framing: {framing}] {style} style video showing {action}. Set in {environment}. {lighting} Duration: {duration}s. {negative}",
    "supports_negative": false,
    "max_duration": 16,
    "aspect_ratio_support": ["16:9", "9:16", "1:1", "4:3", "3:4"],
    "negative_placeholder": "",
    "notes": "Camera direction must come first. Keep prompts concise. No negative prompt support.",
    "enhancement_rules": {
      "preferred_order": ["camera", "framing", "style", "action", "environment", "lighting", "duration"],
      "keyword_injection": {
        "camera_keywords": ["lens", "focal length", "aperture", "depth of field"],
        "style_keywords": ["cinematic", "photorealistic", "film grain", "color graded"],
        "action_keywords": ["smooth motion", "continuous movement", "natural physics"]
      },
      "prompt_guidelines": {
        "max_length": 300,
        "sentence_style": "concise",
        "camera_first": true,
        "avoid_adjectives": ["stunning", "breathtaking", "amazing"],
        "prefer_specifics": ["50mm lens", "f/2.8", "shallow depth of field", "medium close-up"]
      }
    }
  },
  "google_veo3_1": {
    "label": "Google Veo 3.1",
    "template": "{style}. {lighting}. A {duration}-second clip showing {action} in {environment}. Camera: {camera}, framed as {framing}. {color_grading}. {negative}",
    "supports_negative": true,
    "max_duration": 60,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "Avoid: {negative}",
    "notes": "Thrives on environment physics, color grading, and realistic scene details. Supports negative prompts.",
    "enhancement_rules": {
      "preferred_order": ["style", "lighting", "action", "environment", "camera", "framing", "color_grading"],
      "keyword_injection": {
        "environment_keywords": ["realistic physics", "natural lighting interaction", "spatial depth", "atmospheric perspective"],
        "color_keywords": ["color palette", "tonal range", "color temperature", "saturation level"],
        "physics_keywords": ["gravity", "momentum", "fluid dynamics", "light reflection", "shadow casting"]
      },
      "prompt_guidelines": {
        "max_length": 500,
        "sentence_style": "descriptive",
        "emphasize_physics": true,
        "emphasize_environment": true,
        "prefer_specifics": ["warm golden hour light", "cool blue shadows", "volumetric fog", "natural color grading"]
      }
    }
  },
  "kling_3_0": {
    "label": "Kling 3.0",
    "template": "{action}, captured via {camera} in {framing}. Location: {environment}. Style: {style}. Atmosphere: {lighting}. Duration: {duration}s. Color: {color_grading}. {negative}",
    "supports_negative": true,
    "max_duration": 30,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "Negative prompt: {negative}",
    "notes": "Responds well to fluid action sequences, motion pacing terms, and atmospheric composition.",
    "enhancement_rules": {
      "preferred_order": ["action", "camera", "framing", "environment", "style", "lighting", "duration", "color_grading"],
      "keyword_injection": {
        "motion_keywords": ["fluid motion", "smooth tracking", "dynamic movement", "continuous flow", "natural pacing"],
        "atmosphere_keywords": ["moody atmosphere", "ambient lighting", "cinematic mood", "dramatic tension"],
        "pacing_keywords": ["slow motion", "real-time", "accelerated", "rhythmic movement"]
      },
      "prompt_guidelines": {
        "max_length": 400,
        "sentence_style": "action-first",
        "emphasize_motion": true,
        "emphasize_atmosphere": true,
        "prefer_specifics": ["smooth gimbal tracking", "slow-motion capture", "dramatic backlighting", "moody atmosphere"]
      }
    }
  },
  "sora_2": {
    "label": "OpenAI Sora 2",
    "template": "A {duration}-second video in {style}. {action}. The scene is set in {environment}, captured with {camera} and {framing}. Lighting: {lighting}. Color grading: {color_grading}. {negative}",
    "supports_negative": true,
    "max_duration": 60,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "Exclude: {negative}",
    "notes": "Prefers natural language descriptions. Strong at physics simulation and complex motion.",
    "enhancement_rules": {
      "preferred_order": ["duration", "style", "action", "environment", "camera", "framing", "lighting", "color_grading"],
      "keyword_injection": {
        "temporal_keywords": ["over the course of", "gradually", "in sequence", "as time progresses", "moment by moment"],
        "physics_keywords": ["realistic physics", "natural motion", "accurate gravity", "proper momentum", "realistic interaction"],
        "narrative_keywords": ["the scene unfolds", "progressively", "building toward", "culminating in"]
      },
      "prompt_guidelines": {
        "max_length": 600,
        "sentence_style": "narrative",
        "emphasize_temporal_flow": true,
        "emphasize_physics": true,
        "prefer_specifics": ["the camera slowly reveals", "as the action progresses", "natural light shifts", "realistic object interaction"]
      }
    }
  },
  "luma_dream_machine": {
    "label": "Luma Dream Machine",
    "template": "{style} video, {duration}s. {action}. {environment}. Shot with {camera}, {framing}. {lighting}. {color_grading}. {negative}",
    "supports_negative": false,
    "max_duration": 12,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
