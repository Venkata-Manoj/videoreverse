    "enhancement_rules": {
      "preferred_order": ["style", "duration", "action", "environment", "camera", "framing", "lighting"],
      "keyword_injection": {
        "motion_keywords": ["realistic motion", "natural movement", "smooth animation"],
        "brevity_keywords": ["", "", ""]
      },
      "prompt_guidelines": {
        "max_length": 200,
        "sentence_style": "ultra-concise",
        "emphasize_brevity": true,
        "emphasize_realism": true,
        "prefer_specifics": ["photorealistic", "natural motion", "clean composition"]
      }
    }
  },
  "pika_2": {
    "label": "Pika 2.0",
    "template": "{style}. {action}. {environment}. {camera}, {framing}. {lighting}. {negative}",
