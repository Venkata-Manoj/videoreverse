      "prompt_guidelines": {
        "max_length": 200,
        "sentence_style": "photorealistic",
        "emphasize_realism": true,
        "emphasize_quality": true,
        "prefer_specifics": ["photorealistic rendering", "natural skin tones", "accurate lighting", "sharp detail"]
      }
    }
  },
  "stable_video_diffusion": {
    "label": "Stable Video Diffusion",
    "template": "{style}, {action}, {environment}, {camera}, {framing}, {lighting}, {color_grading}, {negative}",
    "supports_negative": true,
    "max_duration": 4,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "negative prompt: {negative}",
    "notes": "Very short clips. Comma-separated format works best. Strong negative prompt support.",
    "enhancement_rules": {
      "preferred_order": ["style", "action", "environment", "camera", "framing", "lighting", "color_grading"],
      "keyword_injection": {
        "comma_keywords": ["", "", ""],
        "negative_keywords": ["blurry", "low quality", "distorted", "unnatural", "artifacts", "noise", "deformed"]
      },
      "prompt_guidelines": {
        "max_length": 150,
        "sentence_style": "comma-separated",
        "emphasize_comma_format": true,
        "emphasize_negative": true,
        "prefer_specifics": ["masterpiece", "best quality", "high resolution", "sharp focus"]
      }
    }
  }
}
