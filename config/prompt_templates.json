  "sora_2": {
    "label": "OpenAI Sora 2",
    "template": "A {duration}-second video in {style}. {action}. The scene is set in {environment}, captured with {camera} and {framing}. Lighting: {lighting}. Color grading: {color_grading}. {negative}",
    "supports_negative": true,
    "max_duration": 60,
    "aspect_ratio_support": ["16:9", "9:16", "1:1"],
    "negative_placeholder": "Exclude: {negative}",
    "notes": "Prefers natural language descriptions. Strong at physics simulation, complex motion, and multi-shot sequences. Best with narrative flow.",
    "enhancement_rules": {
      "preferred_order": ["duration", "style", "action", "environment", "camera", "framing", "lighting", "color_grading"],
      "keyword_injection": {
        "temporal_keywords": ["over the course of", "gradually", "in sequence", "as time progresses", "moment by moment", "the scene unfolds", "progressively"],
        "physics_keywords": ["realistic physics", "natural motion", "accurate gravity", "proper momentum", "realistic interaction", "object permanence"],
        "narrative_keywords": ["the scene unfolds", "progressively", "building toward", "culminating in", "revealing", "transitioning to"],
        "spatial_keywords": ["in the foreground", "in the background", "to the left", "panning right", "revealing behind"],
        "causal_keywords": ["causing", "triggering", "resulting in", "leading to", "as a consequence"]
      },
      "prompt_guidelines": {
        "max_length": 600,
        "sentence_style": "narrative",
        "emphasize_temporal_flow": true,
        "emphasize_physics": true,
        "emphasize_causal_relationships": true,
        "avoid_adjectives": ["stunning", "breathtaking", "amazing"],
        "prefer_specifics": ["the camera slowly reveals", "as the action progresses", "natural light shifts", "realistic object interaction", "cause and effect"],
        "composition_tips": "Sora understands causality and temporal flow. Describe how events lead to other events. Use narrative language rather than technical jargon."
      }
    }
  },
